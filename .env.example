# Vercel Edge Functions key for Twelve Data (api/market.ts, api/history.ts).
# Required for the Markets cards (oil, indices, Ibovespa, Merval, grains).
# The rest of the app works without it. Get a free key at https://twelvedata.com
TWELVE_DATA_API_KEY=

# Set to "true" to disable Vercel Web Analytics in the build.
VITE_DISABLE_ANALYTICS=
